# Optional Docker Compose overrides for local development.
# The stack starts without this file. Copy it to `.env` OR run with
# `docker compose --env-file .env.docker up --build` if you want custom values.
# Never reuse these LOCAL-ONLY examples in production.

# Optional for S0→S2 acceptance. Leave blank if you only want Profile/Batch planning.
GEMINI_API_KEY=

APP_DEFAULT_LANGUAGE=es
LANGUAGE_MIN_CONFIDENCE=0.6
LANGUAGE_MIN_MARGIN=0.2

# Stable local bootstrap identity. Do not expose this as client input.
PRODAGENTIC_DEPLOYMENT_KEY=local-docker-installation

# Local operator auth. Defaults already exist in docker-compose.yml so the stack
# is zero-config on loopback; override them before using non-test local data.
PRODAGENTIC_AUTH_ENABLED=true
PRODAGENTIC_ADMIN_USER=admin
PRODAGENTIC_ADMIN_PASSWORD=local-docker-password-change-me
PRODAGENTIC_SESSION_SECRET=local-docker-session-secret-change-me-0123456789abcdef
PRODAGENTIC_SESSION_TTL_SECONDS=43200

# Browser/network boundary.
# Default mode stays loopback-only and needs no values here.
#
# Native Docker Engine inside WSL NAT fallback:
#   WSL_IP=$(hostname -I | awk '{print $1}')
# Then set the following values to that private WSL IP before rebuilding:
#   PRODAGENTIC_WEB_BIND_HOST=<WSL_IP>
#   NEXT_PUBLIC_API_URL=http://<WSL_IP>:8000
#   PRODAGENTIC_ALLOW_PRIVATE_HTTP_API=true
#   CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://<WSL_IP>:3000
#   FRONTEND_URL=http://<WSL_IP>:3000
#
# Do not set PRODAGENTIC_ALLOW_PRIVATE_HTTP_API=true for public/non-RFC1918 origins.
PRODAGENTIC_WEB_BIND_HOST=127.0.0.1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PRODAGENTIC_ALLOW_PRIVATE_HTTP_API=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# LinkedIn is intentionally UNCONFIGURED for S0→S2 acceptance.
# Only fill these when deliberately testing the existing LinkedIn integration.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/linkedin/callback
PRODAGENTIC_LINKEDIN_TOKEN_KEY=
LINKEDIN_API_VERSION=202608

# External workflow integration remains disabled unless deliberately configured.
N8N_WEBHOOK_URL=
