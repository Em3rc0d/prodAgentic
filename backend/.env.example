# Copy this to .env and fill in your values
# .env is git-ignored; this file is NOT

# --- Required ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- Required: default language when AUTO is selected and detection fails ---
# Must be one of: es, en, pt
APP_DEFAULT_LANGUAGE=es

# --- Language validation thresholds ---
LANGUAGE_MIN_CONFIDENCE=0.6
LANGUAGE_MIN_MARGIN=0.2

# --- Visual rendering ---
# Set to "false" or "0" to disable image rendering entirely (kill switch)
IMAGE_RENDER_ENABLED=true

# --- Database ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=content_engine

# --- MK1 S0 tenancy and feature gates ---
# Optional stable UUID. If omitted, a deterministic ID is derived server-side
# from PRODAGENTIC_DEPLOYMENT_KEY. Never expose either value as client input.
# PRODAGENTIC_BOOTSTRAP_TENANT_ID=00000000-0000-0000-0000-000000000000
PRODAGENTIC_DEPLOYMENT_KEY=local-installation
MK1_ENABLED=false

# --- First-release admin boundary ---
PRODAGENTIC_AUTH_ENABLED=true
PRODAGENTIC_ADMIN_USER=admin
PRODAGENTIC_ADMIN_PASSWORD=replace-with-at-least-12-characters
PRODAGENTIC_SESSION_SECRET=replace-with-at-least-32-random-characters
PRODAGENTIC_SESSION_TTL_SECONDS=43200
# Local HTTP development must be false so the browser can return the session cookie
# to the LinkedIn OAuth callback. Production must set this to true.
PRODAGENTIC_COOKIE_SECURE=false
PRODAGENTIC_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# --- LinkedIn OAuth ---
# prodAgentic requests only: openid, profile, w_member_social.
# email may be provisioned by LinkedIn but is not requested or persisted.
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/integrations/linkedin/callback
# Use an independent random secret of at least 32 characters. It encrypts stored OAuth tokens.
PRODAGENTIC_LINKEDIN_TOKEN_KEY=replace-with-at-least-32-random-characters
LINKEDIN_API_VERSION=202608
# Emergency/dev-only compatibility path for manually injected access tokens.
LINKEDIN_STATIC_FALLBACK_ENABLED=false
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:<member-id>

# --- N8N integration (optional) ---
# N8N_WEBHOOK_URL=https://your-domain/webhook/social-media-post
# N8N_ALLOW_DIRECT_FALLBACK=true
