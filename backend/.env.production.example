# prodAgentic production runtime contract
# Copy into your hosting service's secret/environment configuration.
PRODAGENTIC_ENV=production

# Core AI/runtime
APP_DEFAULT_LANGUAGE=es
LANGUAGE_MIN_CONFIDENCE=0.6
LANGUAGE_MIN_MARGIN=0.2
IMAGE_RENDER_ENABLED=true
GEMINI_API_KEY=<secret>

# Durable state
MONGO_URI=<secret-mongodb-uri>
MONGO_DB=content_engine

# Product-owned visual bytes. This MUST resolve to durable storage on your host.
# The production startup gate rejects an implicit/relative asset path.
PRODAGENTIC_ASSET_ROOT=/data/prodagentic/assets

# Admin/session security
PRODAGENTIC_AUTH_ENABLED=true
PRODAGENTIC_ADMIN_USER=admin
PRODAGENTIC_ADMIN_PASSWORD=<secret-at-least-12-characters>
PRODAGENTIC_SESSION_SECRET=<secret-at-least-32-characters>
PRODAGENTIC_SESSION_TTL_SECONDS=43200
# Production requires Secure + SameSite=None so a separately hosted frontend can
# authenticate against the API without weakening the browser boundary.
PRODAGENTIC_COOKIE_SECURE=true
PRODAGENTIC_COOKIE_SAMESITE=none
# Exact HTTPS frontend origin(s), comma-separated when more than one is intentional.
# FRONTEND_URL itself must be present in this list.
CORS_ALLOWED_ORIGINS=https://<production-frontend-domain>
FRONTEND_URL=https://<production-frontend-domain>

# Scheduled delivery. First release must run one scheduler authority only.
# If the backend process owns scheduling, keep exactly one backend application replica.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30

# LinkedIn OAuth. Client secret and token encryption key are backend-only secrets.
LINKEDIN_CLIENT_ID=<linkedin-app-client-id>
LINKEDIN_CLIENT_SECRET=<secret>
LINKEDIN_REDIRECT_URI=https://<production-backend-domain>/api/integrations/linkedin/callback
PRODAGENTIC_LINKEDIN_TOKEN_KEY=<secret-at-least-32-random-characters>
LINKEDIN_API_VERSION=202607

# Static publishing authority is development/emergency-only and is rejected by
# the production startup gate.
LINKEDIN_STATIC_FALLBACK_ENABLED=false
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:<member-id>

# Optional n8n path; leave unset when direct provider routing is intended.
# N8N_WEBHOOK_URL=
# N8N_ALLOW_DIRECT_FALLBACK=false
