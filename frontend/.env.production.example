# Public browser-visible API origin. Production must use the deployed HTTPS backend origin.
NEXT_PUBLIC_API_URL=https://<production-backend-domain>

# MK1 UI authorities. Phase H cutover enables all certified V1 surfaces together.
# Keep them false until the Phase H release candidate is certified; do not expose a
# partially enabled shell in production.
NEXT_PUBLIC_MK1_SHELL=false
NEXT_PUBLIC_MK1_PROFILE_V2=false
NEXT_PUBLIC_MK1_BATCH_PLANNING=false
NEXT_PUBLIC_MK1_MANUAL_EXPORT=false
NEXT_PUBLIC_MK1_PUBLISHING=false
NEXT_PUBLIC_MK1_ANALYTICS=false
