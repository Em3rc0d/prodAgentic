# Public browser-visible API origin. Use the deployed HTTPS backend origin.
NEXT_PUBLIC_API_URL=https://<production-backend-domain>

# MK1 UI authorities. Keep disabled until each slice is certified for rollout.
NEXT_PUBLIC_MK1_SHELL=false
NEXT_PUBLIC_MK1_PROFILE_V2=false
NEXT_PUBLIC_MK1_BATCH_PLANNING=false
